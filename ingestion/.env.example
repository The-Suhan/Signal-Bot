# Twelve Data
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOL=XAU/USD

# Redis (aynı Redis instance'ı Laravel ile paylaşılır)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis anahtar/kanal isimleri
REDIS_TICK_CHANNEL=price:XAUUSD:tick
REDIS_LAST_PRICE_KEY=price:XAUUSD:last

# Postgres (Laravel ile aynı veritabanı — candles tablosuna doğrudan yazılır)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=xauusd_signal
PGUSER=postgres
PGPASSWORD=

# candles tablosundaki symbol değeri (Laravel migration'daki default ile aynı olmalı)
CANDLE_SYMBOL=XAUUSD
